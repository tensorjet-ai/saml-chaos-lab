{
  "name": "saml-chaos-lab-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter saml-chaos-lab build && tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/*.test.ts test/conformance/*.test.ts test/integration/*.test.ts test/abuse/*.test.ts",
    "test:e2e": "pnpm --filter saml-chaos-lab build && vitest run test/e2e"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.1.0",
    "@peculiar/x509": "2.0.0",
    "@xmldom/xmldom": "0.9.10",
    "fast-xml-parser": "5.10.1",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "tsx": "4.23.1",
    "xml-crypto": "6.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@node-saml/node-saml": "5.1.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "prettier": "3.9.5",
    "samlify": "2.13.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
